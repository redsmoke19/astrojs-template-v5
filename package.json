{
  "name": "astro-template-v5",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:js": "eslint \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "lint:js:fix": "eslint \"src/**/*.{js,ts,jsx,tsx,astro}\" --fix",
    "lint:style": "stylelint \"./**/*.{css,scss}\" --ignore-path .gitignore",
    "lint:style:fix": "stylelint \"./**/*.{css,scss}\" --ignore-path .gitignore --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write --list-different .",
    "lint": "npm run lint:prettier && npm run lint:js && npm run lint:style",
    "lint:fix": "npm run lint:prettier:fix && npm run lint:js:fix && npm run lint:style:fix",
    "gen:component": "node ./util/component/gen-component.js"
  },
  "dependencies": {
    "astro": "^5.15.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pathe": "^1.1.2",
    "scroll-lock": "^2.1.5",
    "swiper": "^11.1.15",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/scroll-lock": "^2.1.3",
    "@typescript-eslint/parser": "^8.18.1",
    "astro-icon": "^1.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.83.0",
    "stylelint": "^16.11.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.10.0",
    "typescript": "^5.7.2",
    "vite-plugin-sass-glob-import": "^6.0.0"
  }
}
