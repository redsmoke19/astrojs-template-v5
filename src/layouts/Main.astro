---
import { Header, Footer } from '@shared/components/widgets/layout'

import RootLayout from '@/layouts/root.astro'

interface Props {
  title: string;
  headerMod?: string;
}

const { title, headerMod } = Astro.props;
---

<RootLayout title={title}>
  <Header mod={headerMod} />
  <main>
    <slot />
  </main>
  <Footer />
  <slot name="modals" />
</RootLayout>
