---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  className?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  className = '',
  type = 'button',
  disabled = false
} = Astro.props

const baseClasses =
  'inline-flex items-center justify-center gap-2 font-semibold transition-all duration-250 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-50 disabled:cursor-not-allowed'

const variantClasses = {
  primary: 'bg-primary text-white hover:bg-[#3730a3] active:translate-y-0 hover:-translate-y-0.5',
  secondary:
    'bg-secondary text-white hover:bg-[#0891b2] active:translate-y-0 hover:-translate-y-0.5',
  outline:
    'bg-transparent text-primary border-2 border-primary hover:bg-primary hover:text-white active:translate-y-0 hover:-translate-y-0.5'
}

const sizeClasses = {
  sm: 'px-md py-xs text-sm rounded-md',
  md: 'px-lg py-sm text-base rounded-md',
  lg: 'px-xl py-md text-lg rounded-md'
}

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

<button type={type} class={classes} disabled={disabled}>
  <slot />
</button>
