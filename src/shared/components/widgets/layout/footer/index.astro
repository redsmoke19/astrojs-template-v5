<footer class="bg-gray-50 border-t border-gray-200 pt-4 pb-4">
  <div class="container w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-6">
      <div class="flex flex-col gap-4">
        <h3 class="text-lg font-semibold text-gray-900 m-0">О компании</h3>
        <p class="text-base text-gray-600 leading-relaxed m-0">
          Современный шаблон для разработки с поддержкой TypeScript, SCSS и всех необходимых инструментов
        </p>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-lg font-semibold text-gray-900 m-0">Навигация</h3>
        <ul class="flex flex-col gap-sm list-none m-0 p-0">
          <li class="list-none">
            <a
              href="/"
              class="text-base text-gray-600 no-underline transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              Главная
            </a>
          </li>
          <li class="list-none">
            <a
              href="/about"
              class="text-base text-gray-600 no-underline transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              О нас
            </a>
          </li>
          <li class="list-none">
            <a
              href="/services"
              class="text-base text-gray-600 no-underline transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              Услуги
            </a>
          </li>
          <li class="list-none">
            <a
              href="/contact"
              class="text-base text-gray-600 no-underline transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              Контакты
            </a>
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-lg font-semibold text-gray-900 m-0">Контакты</h3>
        <ul class="flex flex-col gap-sm list-none m-0 p-0">
          <li class="list-none">
            <a
              href="mailto:info@example.com"
              class="text-base text-gray-600 no-underline transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              info@example.com
            </a>
          </li>
          <li class="list-none">
            <a
              href="tel:+79001234567"
              class="text-base text-gray-600 no-underline transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              +7 (900) 123-45-67
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-4 border-t border-gray-200 text-center">
      <p class="text-sm text-gray-600 m-0">
        © {new Date().getFullYear()} Все права защищены
      </p>
    </div>
  </div>
</footer>
